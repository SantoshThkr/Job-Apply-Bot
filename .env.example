# Job matching runs on a local model through Ollama: free, and job data never leaves this machine.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Any model you have pulled with `ollama pull`. qwen3:4b needs about 3.5 GB of free RAM; qwen3:8b about 6 GB.
OLLAMA_MODEL=qwen3:4b
# Jobs analyzed at the same time. Keep 1 for a local model so the machine stays usable.
AI_CONCURRENCY=1
# Attempts per job when the model's output fails validation; after that the job is marked ANALYSIS_FAILED.
AI_MAX_ATTEMPTS=3

# Optional paid alternative: set AI_PROVIDER=openai and fill these in.
OPENAI_API_KEY=
OPENAI_MODEL=

# Naukri serves "Access Denied" to headless Chrome, so leave this false for real runs.
HEADLESS=false
# "chrome" uses your installed Google Chrome; "chromium" uses Playwright's bundled build.
BROWSER_CHANNEL=chrome

# Jobs scoring at least this are SHORTLISTED (and can be applied to); 60 up to this score are REVIEW;
# below 60 are SKIPPED. Experience never changes the score or filters a job.
MIN_MATCH_SCORE=75
# Result pages read per keyword and location. Naukri can list hundreds of pages; each is a page load.
SEARCH_MAX_PAGES=10
# Optional cap on new jobs stored per search run. Leave it out for no limit.
# MAX_JOBS_PER_RUN=500
# Pause between page loads, so a run doesn't hammer Naukri.
DELAY_MIN_MS=1500
DELAY_MAX_MS=4000

# Applying. Fields and recruiter questions are answered only from config/answers.json and your
# profile/resume details.
AUTO_FILL=true
# false: the bot opens each job and stops before Apply (jobs end as READY_TO_APPLY).
# true: it clicks Apply, which on Naukri sends the application; each is marked APPLIED only once
# Naukri confirms it. The dashboard's Apply page can switch this per run.
AUTO_APPLY=false
# Wait after each Apply click before the next job.
APPLY_DELAY_MS=10000
# Screenshots of each application step in data/debug/<run id>/. They can show personal details.
DEBUG_SCREENSHOTS=false

# The dashboard's local API (npm run server). It only listens on 127.0.0.1.
API_PORT=4100

LOG_LEVEL=info
