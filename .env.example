# Job matching runs on a local model through Ollama: free, and job data never leaves this machine.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Any model you have pulled with `ollama pull`. qwen3:8b needs about 6 GB of free RAM; qwen3:4b about 3.5 GB.
OLLAMA_MODEL=qwen3:8b
# Jobs analyzed at the same time. Keep 1 for a local model so the machine stays usable.
AI_CONCURRENCY=1
# Attempts per job when the model's output fails validation; after that the job is marked ANALYSIS_FAILED.
AI_MAX_ATTEMPTS=3

# Optional paid alternative: set AI_PROVIDER=openai and fill these in.
OPENAI_API_KEY=
OPENAI_MODEL=

# Naukri serves "Access Denied" to headless Chrome, so leave this false for real runs.
HEADLESS=false
# "chrome" uses your installed Google Chrome; "chromium" uses Playwright's bundled build.
BROWSER_CHANNEL=chrome

# Jobs scoring at least this are SHORTLISTED; 60 up to this score are REVIEW; below 60 are SKIPPED.
MIN_MATCH_SCORE=75
AUTO_FILL=true
STOP_BEFORE_SUBMIT=true
MAX_JOBS_PER_RUN=50
DELAY_MIN_MS=1500
DELAY_MAX_MS=4000

LOG_LEVEL=info
